{% extends 'base.html.twig' %}

{% block title %}{{ edit is defined ? 'Modifier' : 'Créer' }} un post | Pawfluence{% endblock %}

{% block body %}
<main>
    <section class="wrapperForm">
        <article class="welcomeAdd">
            <h1>{{ edit is defined ? 'Modifier votre post' : 'Créer un nouveau post' }}</h1>
            <p>Racontez votre aventure en quelques lignes.</p>
        </article>

        <div class="form">
            {{ form_start(formAddPost) }}
            {{ form_errors(formAddPost) }}
            <div class="formRow">
                {{ form_row(formAddPost.postTitle) }}
                {{ form_row(formAddPost.textuelContent) }}
                {{ form_row(formAddPost.visuelContent) }}
                {{ form_row(formAddPost.associatedTo) }}
                {{ form_row(formAddPost.valider) }}
            </div>
            {{ form_end(formAddPost) }}
        </div>
    </section>
</main>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}{{ edit is defined ? 'Modifier le post' : 'Créer un post' }} | PawFluence{% endblock %}

{% block body %}
<section class="form-wrap">
    <h1>{{ edit is defined ? 'Modifier votre post' : 'Créer un nouveau post' }}</h1>
    {{ form_start(formAddPost, {'attr': {'class': 'styled-form'}}) }}
        {{ form_row(formAddPost.postTitle) }}
        {{ form_row(formAddPost.textuelContent) }}
        {{ form_row(formAddPost.visuelContent) }}
        {{ form_row(formAddPost.associatedTo) }}
        {{ form_row(formAddPost.valider, {'attr': {'class': 'btn'}}) }}
    {{ form_end(formAddPost) }}
</section>
{% endblock %}

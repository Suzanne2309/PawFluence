{% extends 'base.html.twig' %}

{% block title %}Créer un post | PawFluence{% endblock %}

{% block body %}
<main class="page page--form">
    <section class="form-card">
        <p class="eyebrow">Création</p>
        <h1>Créer une publication</h1>
        <p>Partagez une nouvelle histoire avec votre communauté.</p>

        {{ form_start(formAddPost) }}
            {{ form_errors(formAddPost) }}
            {{ form_row(formAddPost.postTitle) }}
            {{ form_row(formAddPost.textuelContent) }}
            {{ form_row(formAddPost.visuelContent) }}
            {{ form_row(formAddPost.associatedTo) }}
            {{ form_row(formAddPost.valider) }}
        {{ form_end(formAddPost) }}
    </section>
</main>
{% endblock %}

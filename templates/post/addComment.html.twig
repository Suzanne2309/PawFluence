{% extends 'base.html.twig' %}

{% block title %}{{ edit is defined ? 'Modifier' : 'Ajouter' }} un commentaire | Pawfluence{% endblock %}

{% block body %}
<main>
    <section class="wrapperForm">
        <article class="welcomeAdd">
            <h1>{{ edit is defined ? 'Modifier votre commentaire' : 'Ajouter un commentaire' }}</h1>
            <p>Partagez votre avis de manière constructive.</p>
        </article>

        <div class="form">
            {{ form_start(formAddComment) }}
            {{ form_errors(formAddComment) }}
            <div class="formRow">
                {{ form_row(formAddComment.commentTitle) }}
                {{ form_row(formAddComment.message) }}
                {{ form_row(formAddComment.valider) }}
            </div>
            {{ form_end(formAddComment) }}
        </div>
    </section>
</main>
{% endblock %}

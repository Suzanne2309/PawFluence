{% extends 'base.html.twig' %}

{% block title %}{{ edit is defined ? 'Modifier le commentaire' : 'Ajouter un commentaire' }} | PawFluence{% endblock %}

{% block body %}
<section class="form-wrap">
    <h1>{{ edit is defined ? 'Modifier votre commentaire' : 'Nouveau commentaire' }}</h1>
    {{ form_start(formAddComment, {'attr': {'class': 'styled-form'}}) }}
        {{ form_row(formAddComment.commentTitle) }}
        {{ form_row(formAddComment.message) }}
        {{ form_row(formAddComment.valider, {'attr': {'class': 'btn'}}) }}
    {{ form_end(formAddComment) }}
</section>
{% endblock %}

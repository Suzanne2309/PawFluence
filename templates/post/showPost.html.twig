{% extends 'base.html.twig' %}

{% block title %}{{ post }} | PawFluence{% endblock %}

{% block body %}
<main class="page page--detail">
    <article class="post-detail">
        <header class="post-detail__header">
            <p class="eyebrow">Publication</p>
            <h1>{{ post }}</h1>
            <p>Par <strong>{{ post.userOfPost }}</strong> · {{ post.publicationDateFr }}</p>
        </header>

        <p class="post-detail__content">{{ post.textuelContent }}</p>

        <div class="tag-list">
            {% for tag in post.associatedTo %}
                <span class="tag">#{{ tag.tagName }}</span>
            {% endfor %}
        </div>

        {% if app.user %}
            <div class="post-item__actions">
                <a class="btn btn--ghost" href="{{ path('add_comment', {'id': post.id}) }}">Commenter</a>
                {% if app.user is same as(post.UserOfPost) %}
                    <a class="btn btn--ghost" href="{{ path('edit_post', {'id': post.id}) }}">Modifier</a>
                    <a class="btn" href="{{ path('delete_post', {'id': post.id}) }}">Supprimer</a>
                {% endif %}
            </div>
        {% endif %}
    </article>

    <section class="comments-block" aria-label="Commentaires">
        <h2>Commentaires</h2>
        <div class="feed-list">
            {% if comments is defined and comments|length > 0 %}
                {% for comment in comments %}
                    <article class="post-item">
                        <header class="post-item__header">
                            <div>
                                <p class="post-item__author">{{ comment.commentUser }}</p>
                                <p class="post-item__date">{{ comment.publicationDateFr }}</p>
                            </div>
                            <p class="post-item__title">{{ comment }}</p>
                        </header>
                        <p>{{ comment.message }}</p>

                        {% if app.user is same as(comment.commentUser) %}
                            <footer class="post-item__actions">
                                <a class="btn btn--ghost" href="{{ path('edit_comment', {'id': comment.id}) }}">Modifier</a>
                                <a class="btn" href="{{ path('delete_comment', {'id': comment.id}) }}">Supprimer</a>
                            </footer>
                        {% endif %}
                    </article>
                {% endfor %}
            {% else %}
                <article class="empty-state">
                    <p>Aucun commentaire pour le moment.</p>
                </article>
            {% endif %}
        </div>
    </section>
</main>
{% endblock %}

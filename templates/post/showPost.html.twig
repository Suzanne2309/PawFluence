{% extends 'base.html.twig' %}

{% block title %}Détail du post | Pawfluence{% endblock %}

{% block body %}
<main>
    <section class="postDetailWrapper">
        <article class="postCard">
            <h1>{{ post }}</h1>
            <p>Publié par <strong>{{ post.userOfPost }}</strong> · {{ post.publicationDateFr }}</p>
            <p>{{ post.textuelContent }}</p>
            <div>
                {% for tag in post.associatedTo %}
                    <span class="tag">#{{ tag.tagName }}</span>
                {% endfor %}
            </div>

            {% if app.user %}
                <div class="btnInteractions">
                    <a class="btn btn-ghost" href="{{ path('add_comment', {'id': post.id}) }}">Ajouter un commentaire</a>
                    {% if app.user is same as(post.userOfPost) %}
                        <a class="btn btn-ghost" href="{{ path('edit_post', {'id': post.id}) }}">Modifier</a>
                        <a class="btn btn-ghost" href="{{ path('delete_post', {'id': post.id}) }}">Supprimer</a>
                    {% endif %}
                </div>
            {% endif %}
        </article>
    </section>

    <section class="wrapperPostList">
        <h2>Commentaires</h2>
        <ul class="listPost">
            {% for comment in comments %}
                <li class="postCard">
                    <h3>{{ comment.commentTitle }}</h3>
                    <p>{{ comment.message }}</p>
                    <p>Par <strong>{{ comment.commentUser }}</strong> · {{ comment.publicationDateFr }}</p>
                    {% if app.user and app.user is same as(comment.commentUser) %}
                        <div class="btnInteractions">
                            <a class="btn btn-ghost" href="{{ path('edit_comment', {'id': comment.id}) }}">Modifier</a>
                            <a class="btn btn-ghost" href="{{ path('delete_comment', {'id': comment.id}) }}">Supprimer</a>
                        </div>
                    {% endif %}
                </li>
            {% else %}
                <li class="postCard"><p>Aucun commentaire pour ce post.</p></li>
            {% endfor %}
        </ul>
    </section>
</main>
{% endblock %}

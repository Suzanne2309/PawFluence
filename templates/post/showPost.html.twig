{% extends 'base.html.twig' %}
{% block title %}{{ post.postTitle }}{% endblock %}
{% block body %}
<article class="card feed-card">
    <div class="feed-head">
        <div class="meta">
            <img class="avatar" src="{{ post.userOfPost and post.userOfPost.avatar ? post.userOfPost.avatar : asset('img/Pawfluence.webp') }}" alt="avatar">
            <strong>{{ post.userOfPost ? post.userOfPost.pseudo : 'Membre' }}</strong>
            <span>• {{ post.publicationDateFr }}</span>
        </div>
    </div>
    {% if post.visuelContent %}<img class="post-image" src="{{ post.visuelContent }}" alt="visuel">{% endif %}
    <div class="feed-body">
        <h1>{{ post.postTitle }}</h1>
        <p>{{ post.textuelContent }}</p>
        <div class="tag-row">{% for tag in post.associatedTo %}<span class="tag">#{{ tag.tagName }}</span>{% endfor %}</div>
    </div>
    <div class="feed-foot quick-actions">
        <button class="btn btn-ghost" type="button" data-like-btn data-state="off">♡ J’aime</button>
        <button class="btn btn-ghost" type="button" data-save-btn data-state="off">⤴ Sauvegarder</button>
        {% if app.user %}<a class="btn" href="{{ path('add_comment', {id: post.id}) }}">Commenter</a>{% endif %}
    </div>
</article>

<section class="feed" style="margin-top:1rem;">
    <h2>Commentaires</h2>
    {% for comment in comments %}
        <article class="card">
            <div class="meta"><strong>{{ comment.commentUser ? comment.commentUser.pseudo : 'Membre' }}</strong><span>• {{ comment.publicationDateFr }}</span></div>
            <h3>{{ comment.commentTitle }}</h3>
            <p>{{ comment.message }}</p>
            {% if app.user and comment.commentUser and app.user.id == comment.commentUser.id %}
                <div class="quick-actions">
                    <a class="btn btn-ghost" href="{{ path('edit_comment', {id: comment.id}) }}">Éditer</a>
                    <a class="btn btn-danger" href="{{ path('delete_comment', {id: comment.id}) }}">Supprimer</a>
                </div>
            {% endif %}
        </article>
    {% else %}
        <article class="card empty-state"><p>Aucun commentaire.</p></article>
    {% endfor %}
</section>
{% endblock %}

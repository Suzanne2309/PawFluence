{% extends 'base.html.twig' %}

{% block title %}Explorer | PawFluence{% endblock %}

{% block body %}
<main class="page page--feed">
    <section class="page-head">
        <div>
            <p class="eyebrow">Feed</p>
            <h1>Explorer les publications</h1>
            <p>Parcourez les contenus de la communauté PawFluence.</p>
        </div>
        {% if app.user %}
            <a class="btn" href="{{ path('add_post') }}">+ Nouveau post</a>
        {% endif %}
    </section>

    <section class="feed-list">
        {% for post in posts %}
            <article class="post-item">
                <header class="post-item__header">
                    <div>
                        <p class="post-item__author">{{ post.userOfPost }}</p>
                        <p class="post-item__date">{{ post.getPublicationDateFr() }}</p>
                    </div>
                    <a class="post-item__title" href="{{ path('show_post', {'id': post.id}) }}">{{ post }}</a>
                </header>

                <div class="tag-list">
                    {% for tag in post.associatedTo %}
                        <span class="tag">#{{ tag.tagName }}</span>
                    {% endfor %}
                </div>

                {% if app.user %}
                    <footer class="post-item__actions">
                        <a class="icon-btn" href="{{ path('add_comment', {'id': post.id}) }}" aria-label="Commenter">💬</a>
                        {% if post.userOfPost == app.user %}
                            <a class="icon-btn icon-btn--danger" href="{{ path('delete_post', {'id': post.id}) }}" aria-label="Supprimer le post">🗑️</a>
                        {% endif %}
                    </footer>
                {% endif %}
            </article>
        {% else %}
            <article class="empty-state">
                <h2>Aucun post pour le moment</h2>
                <p>Soyez la première personne à partager une aventure.</p>
            </article>
        {% endfor %}
    </section>
</main>
{% endblock %}

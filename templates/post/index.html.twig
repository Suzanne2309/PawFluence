{% extends 'base.html.twig' %}

{% block title %}Explorer les posts | Pawfluence{% endblock %}

{% block body %}
<main>
    <section class="wrapperHero hero">
        <div class="title">
            <h1>Explorer les publications</h1>
            <p>Retrouvez les dernières histoires partagées par la communauté.</p>
        </div>
        {% if app.user %}
            <a class="btn btn-primary" href="{{ path('add_post') }}">Créer un post</a>
        {% endif %}
    </section>

    <section class="wrapperPostList">
        <div class="titlePost">
            <h2>Tous les posts</h2>
        </div>

        <div class="listPost">
            <ul>
                {% for post in posts %}
                    <li class="postCard">
                        <a class="postTitle" href="{{ path('show_post', {'id': post.id}) }}">{{ post }}</a>
                        <p>Par <strong>{{ post.userOfPost }}</strong> · {{ post.getPublicationDateFr() }}</p>
                        <div>
                            {% for tag in post.associatedTo %}
                                <span class="tag">#{{ tag.tagName }}</span>
                            {% endfor %}
                        </div>
                        {% if app.user %}
                            <div class="btnInteractions">
                                <a class="btn btn-ghost" href="{{ path('add_comment', {'id': post.id}) }}">Commenter</a>
                                {% if post.userOfPost == app.user %}
                                    <a class="btn btn-ghost" href="{{ path('delete_post', {'id': post.id}) }}">Supprimer</a>
                                {% endif %}
                            </div>
                        {% endif %}
                    </li>
                {% else %}
                    <li class="postCard">
                        <p>Aucun post pour le moment.</p>
                    </li>
                {% endfor %}
            </ul>
        </div>
    </section>
</main>
{% endblock %}

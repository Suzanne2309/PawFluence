{% extends 'base.html.twig' %}

{% block title %}Inscription | Pawfluence{% endblock %}

{% block body %}
<main>
    <section class="wrapperForm">
        <article class="welcome">
            <h1>Créer votre compte</h1>
            <p>Rejoignez Pawfluence et commencez à partager vos expériences.</p>
        </article>

        {% for flash_error in app.flashes('verify_email_error') %}
            <div class="error_message" role="alert">{{ flash_error }}</div>
        {% endfor %}

        <div class="form registerForm">
            {{ form_errors(registrationForm) }}
            {{ form_start(registrationForm) }}
                {{ form_row(registrationForm.pseudo) }}
                {{ form_row(registrationForm.email) }}
                {{ form_row(registrationForm.plainPassword, { label: 'Mot de passe' }) }}
                <div class="checkboxRow">
                    {{ form_widget(registrationForm.agreeTerms) }}
                    {{ form_label(registrationForm.agreeTerms) }}
                    {{ form_errors(registrationForm.agreeTerms) }}
                </div>
                <button type="submit" class="submit">S'inscrire</button>
            {{ form_end(registrationForm) }}
        </div>
    </section>
</main>
{% endblock %}

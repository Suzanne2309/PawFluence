{% extends 'base.html.twig' %}

{% block title %}Éditer mon profil | PawFluence{% endblock %}

{% block body %}
<main class="page page--form">
    <section class="form-card">
        <p class="eyebrow">Profil</p>
        <h1>Modifier mes informations</h1>
        <p>Personnalisez votre profil public.</p>

        {{ form_start(formEditProfile) }}
            {{ form_errors(formEditProfile) }}
            {{ form_row(formEditProfile.avatar) }}
            {{ form_row(formEditProfile._description) }}
            {{ form_row(formEditProfile.tagFollow) }}
            {{ form_row(formEditProfile.valider) }}
        {{ form_end(formEditProfile) }}
    </section>
</main>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Modifier le profil | Pawfluence{% endblock %}

{% block body %}
<main>
    <section class="wrapperForm">
        <article class="welcomeAdd">
            <h1>Mettre à jour votre profil</h1>
            <p>Personnalisez votre avatar et votre description.</p>
        </article>

        <div class="form">
            {{ form_start(formEditProfile) }}
            {{ form_errors(formEditProfile) }}
            <div class="formRow">
                {{ form_row(formEditProfile.avatar) }}
                {{ form_row(formEditProfile._description) }}
                {{ form_row(formEditProfile.tagFollow) }}
                {{ form_row(formEditProfile.valider) }}
            </div>
            {{ form_end(formEditProfile) }}
        </div>
    </section>
</main>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Connexion | Pawfluence{% endblock %}

{% block body %}
<main>
    <section class="wrapperForm">
        {% if app.user %}
            <article class="welcome">
                <h1>Bon retour {{ app.user.pseudo }}</h1>
                <p>Vous êtes déjà connecté.</p>
                <a class="btn btn-primary" href="{{ path('add_post') }}">Créer un post</a>
            </article>
        {% else %}
            <article class="welcome">
                <h1>Connexion</h1>
                <p>Connectez-vous pour publier et interagir avec la communauté.</p>
            </article>
            <form method="post" class="loginForm">
                {% if error %}
                    <div class="error_message">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                {% endif %}
                <label for="username">E-mail</label>
                <input value="{{ last_username }}" name="_username" id="username" type="email" autocomplete="email" required autofocus>

                <label for="password">Mot de passe</label>
                <input type="password" name="_password" id="password" autocomplete="current-password" required>

                <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

                <button class="submit" type="submit">Se connecter</button>
            </form>
        {% endif %}
    </section>
</main>
{% endblock %}

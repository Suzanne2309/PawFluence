{% extends 'base.html.twig' %}

{% block title %}Connexion | PawFluence{% endblock %}

{% block body %}
<main class="page page--form">
    <section class="form-card">
        {% if app.user %}
            <p class="eyebrow">Session active</p>
            <h1>Vous êtes déjà connecté·e</h1>
            <p>Bienvenue {{ app.user.pseudo }}. Vous pouvez retourner au feed.</p>
            <a class="btn" href="{{ path('app_post') }}">Aller au feed</a>
        {% else %}
            <p class="eyebrow">Authentification</p>
            <h1>Connexion</h1>
            <p>Ravi de vous revoir sur PawFluence.</p>

            <form method="post">
                {% if error %}
                    <div class="error_message">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                {% endif %}

                <label for="username">Adresse e-mail</label>
                <input value="{{ last_username }}" name="_username" id="username" type="email" autocomplete="email" required autofocus>

                <label for="password">Mot de passe</label>
                <input type="password" name="_password" id="password" autocomplete="current-password" required>

                <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

                <button class="btn" type="submit">Se connecter</button>
            </form>
        {% endif %}
    </section>
</main>
{% endblock %}

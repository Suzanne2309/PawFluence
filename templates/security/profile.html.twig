{% extends 'base.html.twig' %}

{% block title %}Profil de {{ user.pseudo }} | PawFluence{% endblock %}

{% block body %}
<main class="page page--profile">
    <section class="profile-card">
        <div class="profile-card__avatar">
            {% if user.avatar is empty %}
                <img src="https://images.pexels.com/photos/14205102/pexels-photo-14205102.jpeg" alt="Avatar par défaut">
            {% else %}
                <img src="{{ user.avatar }}" alt="Avatar de {{ user.pseudo }}">
            {% endif %}
        </div>

        <div class="profile-card__body">
            <p class="eyebrow">Profil</p>
            <h1>{{ user.pseudo }}</h1>
            <p>{{ user.description is empty ? 'Aucune description pour le moment.' : user.description }}</p>

            {% if app.user and app.user.Id == user.Id %}
                <a class="btn btn--ghost" href="{{ path('edit_user', {'id': user.id}) }}">Modifier le profil</a>
            {% endif %}
        </div>
    </section>

    <section class="profile-posts">
        <h2>Dernière publication</h2>

        {% if post is empty %}
            <article class="empty-state">
                <p>Aucune publication trouvée.</p>
                {% if app.user and app.user.Id == user.Id %}
                    <a class="btn" href="{{ path('add_post') }}">Publier maintenant</a>
                {% endif %}
            </article>
        {% else %}
            <article class="post-item">
                <header class="post-item__header">
                    <div>
                        <p class="post-item__author">{{ post.userOfPost }}</p>
                        <p class="post-item__date">{{ post.getPublicationDateFr() }}</p>
                    </div>
                    <a class="post-item__title" href="{{ path('show_post', {'id': post.id}) }}">{{ post }}</a>
                </header>
                <div class="tag-list">
                    {% for tag in post.associatedTo %}
                        <span class="tag">#{{ tag.tagName }}</span>
                    {% endfor %}
                </div>

                {% if app.user and app.user.Id == user.Id %}
                    <footer class="post-item__actions">
                        <a class="btn btn--ghost" href="{{ path('add_comment', {'id': post.id}) }}">Commenter</a>
                        <a class="btn" href="{{ path('delete_post', {'id': post.id}) }}">Supprimer</a>
                    </footer>
                {% endif %}
            </article>
        {% endif %}
    </section>
</main>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Profil | Pawfluence{% endblock %}

{% block body %}
<main>
    <section class="profile">
        <div class="avatarCard">
            {% if user.avatar is empty %}
                <img src="https://images.pexels.com/photos/14205102/pexels-photo-14205102.jpeg" alt="Utilisateur sans avatar">
            {% else %}
                <img src="{{ user.avatar }}" alt="Avatar de {{ user.pseudo }}">
            {% endif %}
            <h1>{{ user.pseudo }}</h1>
        </div>

        <div class="profileExtra">
            <p>{{ user.description is empty ? 'Aucune description pour le moment.' : user.description }}</p>
            {% if app.user and app.user.id == user.id %}
                <a class="btn btn-primary" href="{{ path('edit_user', {'id': user.id}) }}">Modifier le profil</a>
            {% endif %}
        </div>
    </section>

    <section class="profilePost">
        <h2>Dernier post partagé</h2>
        {% if post is empty %}
            <p>Aucun post disponible.</p>
            {% if app.user and app.user.id == user.id %}
                <a class="btn btn-primary" href="{{ path('add_post') }}">Créer un post</a>
            {% endif %}
        {% else %}
            <article class="postCard">
                <a class="postTitle" href="{{ path('show_post', {'id': post.id}) }}">{{ post }}</a>
                <p><strong>{{ post.userOfPost }}</strong> · {{ post.getPublicationDateFr() }}</p>
                <div>
                    {% for tag in post.associatedTo %}
                        <span class="tag">#{{ tag.tagName }}</span>
                    {% endfor %}
                </div>
            </article>
        {% endif %}
    </section>
</main>
{% endblock %}

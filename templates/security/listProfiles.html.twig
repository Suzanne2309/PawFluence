{% extends 'base.html.twig' %}

{% block title %}Pawfluencers | Pawfluence{% endblock %}

{% block body %}
<main>
    <section class="wrapperProfilesList">
        <h1>Les Pawfluencers</h1>
        <div class="listProfiles">
            <ul>
                {% for user in users %}
                    <li class="userCard">
                        {% if user.avatar is empty %}
                            <img src="https://images.pexels.com/photos/14205102/pexels-photo-14205102.jpeg" alt="Utilisateur sans avatar">
                        {% else %}
                            <img src="{{ user.avatar }}" alt="Avatar de {{ user }}">
                        {% endif %}
                        <a class="profilePseudo" href="{{ path('show_user', {'id': user.id}) }}">{{ user }}</a>
                        <div>
                            {% for tag in user.tagFollow %}
                                <span class="tag">#{{ tag.tagName }}</span>
                            {% endfor %}
                        </div>
                        <a class="btn btn-primary" href="{{ path('show_user', {'id': user.id}) }}">Voir le profil</a>
                    </li>
                {% else %}
                    <li class="userCard"><p>Aucun profil trouvé.</p></li>
                {% endfor %}
            </ul>
        </div>
    </section>
</main>
{% endblock %}

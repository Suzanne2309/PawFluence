{% extends 'base.html.twig' %}

{% block title %}Profils | PawFluence{% endblock %}

{% block body %}
<div class="page-head">
    <h1>Les profils PawFluence</h1>
</div>

<div class="cards-grid">
    {% for user in users %}
        <article class="card profile-card">
            <img src="{{ user.avatar ?: asset('img/Pawfluence.webp') }}" alt="Avatar {{ user.pseudo }}" class="avatar">
            <h2>{{ user.pseudo }}</h2>
            <p>{{ user.description ?: 'Aucune description pour le moment.' }}</p>
            <a class="btn btn-ghost" href="{{ path('show_user', {id: user.id}) }}">Voir le profil</a>
        </article>
    {% else %}
        <article class="card empty-state">
            <p>Aucun profil disponible.</p>
        </article>
    {% endfor %}
</div>
{% endblock %}

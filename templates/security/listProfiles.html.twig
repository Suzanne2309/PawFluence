{% extends 'base.html.twig' %}

{% block title %}Pawfluencers | PawFluence{% endblock %}

{% block body %}
<main class="page page--profiles">
    <section class="page-head">
        <div>
            <p class="eyebrow">Communauté</p>
            <h1>Les Pawfluencers</h1>
            <p>Découvrez les profils les plus actifs de la plateforme.</p>
        </div>
    </section>

    <section class="profile-grid">
        {% for user in users %}
            <article class="profile-tile">
                {% if user.avatar is empty %}
                    <img src="https://images.pexels.com/photos/14205102/pexels-photo-14205102.jpeg" alt="Avatar par défaut">
                {% else %}
                    <img src="{{ user.avatar }}" alt="Avatar de {{ user }}">
                {% endif %}

                <h2>{{ user }}</h2>

                <div class="tag-list">
                    {% for tag in user.tagFollow %}
                        <span class="tag">#{{ tag.tagName }}</span>
                    {% endfor %}
                </div>

                <a class="btn btn--ghost" href="{{ path('show_user', {'id': user.id}) }}">Voir le profil</a>
            </article>
        {% else %}
            <article class="empty-state">
                <p>Aucun profil à afficher.</p>
            </article>
        {% endfor %}
    </section>
</main>
{% endblock %}

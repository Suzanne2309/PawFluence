{% extends 'base.html.twig' %}

{% block title %}Accueil | Pawfluence{% endblock %}

{% block body %}
<main>
    <section class="wrapperHero hero">
        <div class="title">
            <h1>Bienvenue {% if app.user %}{{ app.user }}{% else %}sur Pawfluence{% endif %}</h1>
            <p>Un espace social pensé pour partager vos histoires animales et soutenir des causes qui comptent.</p>
            <img src="/img/catDogfriends.webp" alt="Un chien et un chat ensemble" loading="lazy">
        </div>

        {% if app.user %}
            <article class="ctaUser">
                <h2>Prêt à publier votre nouvelle aventure ?</h2>
                <p>Votre communauté attend vos anecdotes et vos conseils.</p>
                <a class="btn btn-primary" href="{{ path('add_post') }}">Partager maintenant</a>
            </article>
        {% else %}
            <article class="ctaUser">
                <h2>Rejoignez la communauté Pawfluence</h2>
                <p>Créez votre profil en moins d'une minute et échangez avec d'autres passionnés.</p>
                <div class="header-actions">
                    <a class="btn btn-primary" href="{{ path('app_register') }}">Créer un compte</a>
                    <a class="btn btn-ghost" href="{{ path('app_login') }}">J'ai déjà un compte</a>
                </div>
            </article>
        {% endif %}
    </section>

    <section class="wrapperWhat">
        <article class="what">
            <h2>Pourquoi Pawfluence ?</h2>
            <p>Partage, impact et visibilité : tout est réuni pour valoriser votre quotidien avec vos compagnons.</p>
        </article>
        <div class="objectifs">
            <div class="cardWhat"><p>🐾 Soutenir les causes animales.</p></div>
            <div class="cardWhat"><p>📸 Partager vos moments clés.</p></div>
            <div class="cardWhat"><p>💡 Inspirer une communauté engagée.</p></div>
            <div class="cardWhat"><p>🌟 Construire votre présence en ligne.</p></div>
        </div>
    </section>
</main>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Accueil | PawFluence{% endblock %}

{% block body %}
<main class="page page--feed">
    <section class="hero-card">
        <div>
            <p class="eyebrow">Communauté</p>
            <h1>Bienvenue {% if app.user %}{{ app.user.pseudo }}{% else %}sur PawFluence{% endif %}</h1>
            <p>Le réseau social inspiré des créateurs, dédié à nos compagnons à pattes et à la protection animale.</p>
            <div class="hero-card__actions">
                {% if app.user %}
                    <a class="btn" href="{{ path('add_post') }}">Créer un post</a>
                    <a class="btn btn--ghost" href="{{ path('app_post') }}">Voir le feed</a>
                {% else %}
                    <a class="btn" href="{{ path('app_register') }}">Rejoindre PawFluence</a>
                    <a class="btn btn--ghost" href="{{ path('app_login') }}">Se connecter</a>
                {% endif %}
            </div>
        </div>
        <img src="/img/catDogfriends.webp" alt="Un chien et un chat allongés ensemble" loading="lazy">
    </section>

    <section class="feature-grid" aria-label="Fonctionnalités">
        <article class="feature-card">
            <h2>Créer</h2>
            <p>Publiez vos aventures et racontez le quotidien de votre compagnon.</p>
        </article>
        <article class="feature-card">
            <h2>Inspirer</h2>
            <p>Partagez vos causes animales, sensibilisez et fédérez la communauté.</p>
        </article>
        <article class="feature-card">
            <h2>Engager</h2>
            <p>Commentez, échangez et développez votre audience comme sur une vraie plateforme sociale.</p>
        </article>
    </section>
</main>
{% endblock %}

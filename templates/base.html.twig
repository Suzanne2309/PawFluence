<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Pawfluence, la plateforme communautaire dédiée aux amoureux des animaux.">
    <title>{% block title %}PawFluence{% endblock %}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('css/style.css') }}">
</head>
<body>
    <div class="site-shell">
        <header class="site-header" id="siteHeader">
            <a class="brand" href="{{ path('app_home') }}" aria-label="Accueil Pawfluence">
                <img src="/img/Pawfluence.webp" alt="Logo Pawfluence" loading="lazy">
                <span>Pawfluence</span>
            </a>

            <button id="burger" class="menu-toggle" type="button" aria-expanded="false" aria-controls="principal" aria-label="Ouvrir le menu">
                <span></span><span></span><span></span>
            </button>

            <nav class="site-nav" id="principal" aria-label="Navigation principale">
                <a href="{{ path('app_home') }}">Accueil</a>
                <a href="{{ path('app_post') }}">Explorer</a>
                <a href="{{ path('app_user') }}">Pawfluencers</a>
            </nav>

            <div class="header-actions">
                {% if app.user %}
                    <a class="btn btn-ghost" href="{{ path('show_user', {'id': app.user.id}) }}">Mon profil</a>
                    <a class="btn btn-primary" href="{{ path('app_logout') }}">Déconnexion</a>
                {% else %}
                    <a class="btn btn-ghost" href="{{ path('app_login') }}">Connexion</a>
                    <a class="btn btn-primary" href="{{ path('app_register') }}">Inscription</a>
                {% endif %}
            </div>
        </header>

        {% block body %}{% endblock %}

        <footer class="site-footer">
            <div>
                <a class="brand" href="{{ path('app_home') }}">
                    <img src="/img/Pawfluence.webp" alt="Logo Pawfluence" loading="lazy">
                    <span>Pawfluence</span>
                </a>
                <p>La communauté qui transforme chaque histoire animale en impact positif.</p>
            </div>
            <nav aria-label="Navigation pied de page">
                <a href="{{ path('app_home') }}">Accueil</a>
                <a href="{{ path('app_post') }}">Explorer</a>
                <a href="{{ path('app_user') }}">Pawfluencers</a>
            </nav>
            <div class="footer-meta">
                <p>© 2026 Pawfluence</p>
                <p>CGU • Confidentialité</p>
            </div>
        </footer>
    </div>

    <script src="{{ asset('js/burger.js') }}"></script>
</body>
</html>

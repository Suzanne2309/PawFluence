<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="PawFluence - Le réseau social des passionnés d'animaux.">
    <title>{% block title %}PawFluence{% endblock %}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('css/style.css') }}">
</head>
<body>
    <a class="skip-link" href="#main-content">Aller au contenu</a>

    <header class="topbar" role="banner">
        <div class="topbar__inner">
            <a href="{{ path('app_home') }}" class="brand" aria-label="Retour à l'accueil PawFluence">
                <img src="/img/Pawfluence.webp" alt="Logo PawFluence" class="brand__logo" loading="lazy">
                <span class="brand__text">PawFluence</span>
            </a>

            <button id="burger" class="menu-toggle" type="button" aria-controls="main-nav" aria-expanded="false" aria-label="Ouvrir la navigation">
                <span class="menu-toggle__bar"></span>
                <span class="menu-toggle__bar"></span>
                <span class="menu-toggle__bar"></span>
            </button>

            <nav id="main-nav" class="topbar__nav" aria-label="Navigation principale">
                <a href="{{ path('app_home') }}">Accueil</a>
                <a href="{{ path('app_post') }}">Explorer</a>
                <a href="{{ path('app_user') }}">Pawfluencers</a>
            </nav>

            <div class="topbar__actions">
                {% if app.user %}
                    <a class="btn btn--ghost" href="{{ path('show_user', {'id': app.user.id}) }}">Mon profil</a>
                    <a class="btn" href="{{ path('app_logout') }}">Déconnexion</a>
                {% else %}
                    <a class="btn btn--ghost" href="{{ path('app_login') }}">Connexion</a>
                    <a class="btn" href="{{ path('app_register') }}">Inscription</a>
                {% endif %}
            </div>
        </div>
    </header>

    <div class="layout-shell" id="main-content">
        {% block body %}{% endblock %}
    </div>

    <footer class="footer">
        <div class="footer__inner">
            <p>© 2026 PawFluence</p>
            <div class="footer__links">
                <a href="#">CGU</a>
                <a href="#">Confidentialité</a>
            </div>
        </div>
    </footer>

    <script src="{{ asset('js/burger.js') }}" defer></script>
</body>
</html>
